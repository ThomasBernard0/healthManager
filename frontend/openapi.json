  "info": {
    "title": "healthManager API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Key"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "GoalDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "validFrom": {
            "type": "string",
            "example": "2026-09-30",
            "description": "First day (YYYY-MM-DD) this goal applies to"
          },
          "dailyKcal": {
            "type": "number",
            "example": 2200
          },
          "protein": {
            "type": "number",
            "example": 150,
            "description": "Daily protein (g)"
          },
          "carbs": {
            "type": "number",
            "example": 230,
            "description": "Daily carbs (g)"
          },
          "fat": {
            "type": "number",
            "example": 70,
            "description": "Daily fat (g)"
          }
        },
        "required": [
          "id",
          "validFrom",
          "dailyKcal",
          "protein",
          "carbs",
          "fat"
        ]
      },
      "CurrentGoalDto": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "example": "2026-10-04",
            "description": "Today in Europe/Paris"
          },
          "goal": {
            "nullable": true,
            "description": "Goal applying today; null before any goal is set",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/GoalDto"
              }
            ]
          }
        },
        "required": [
          "today",
          "goal"
        ]
      },
      "UpdateGoalDto": {
        "type": "object",
        "properties": {
          "dailyKcal": {
            "type": "number",
            "example": 2400,
            "minimum": 500,
            "maximum": 10000
          },
          "protein": {
            "type": "number",
            "example": 160,
            "minimum": 0,
            "maximum": 1000
          },
          "carbs": {
            "type": "number",
            "example": 250,
            "minimum": 0,
            "maximum": 1000
          },
          "fat": {
            "type": "number",
            "example": 80,
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "dailyKcal",
          "protein",
          "carbs",
          "fat"
        ]
      },
      "LogMealDto": {
        "type": "object",
        "properties": {
          "mealId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "example": "2026-10-04"
          },
          "time": {
            "type": "string",
            "example": "12:45"
          },
          "quantity": {
            "type": "number",
            "example": 1,
            "minimum": 0.25,
            "maximum": 20,
            "description": "Portions"
          }
        },
        "required": [
          "mealId",
          "date",
          "time",
          "quantity"
        ]
      },
      "LogKind": {
        "type": "string",
        "enum": [
          "meal",
          "quick"
        ]
      },
      "NutrientsDto": {
        "type": "object",
        "properties": {
          "kcal": {
            "type": "number",
            "example": 640,
            "minimum": 0,
            "maximum": 20000
          },
          "protein": {
            "type": "number",
            "example": 48,
            "minimum": 0,
            "maximum": 5000
          },
          "carbs": {
            "type": "number",
            "example": 72,
            "minimum": 0,
            "maximum": 5000
          },
          "fat": {
            "type": "number",
            "example": 16,
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": [
          "kcal",
          "protein",
          "carbs",
          "fat"
        ]
      },
      "LogEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "example": "2026-10-04"
          },
          "time": {
            "type": "string",
            "example": "12:45"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LogKind"
              }
            ]
          },
          "mealId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Saved meal it was logged from"
          },
          "label": {
            "type": "string",
            "example": "Bowl poulet riz"
          },
          "quantity": {
            "type": "number",
            "example": 1,
            "description": "Portions"
          },
          "snapshot": {
            "description": "Per portion, frozen at log time",
            "allOf": [
              {
                "$ref": "#/components/schemas/NutrientsDto"
              }
            ]
          },
          "total": {
            "description": "snapshot × quantity",
            "allOf": [
              {
                "$ref": "#/components/schemas/NutrientsDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "date",
          "time",
          "kind",
          "mealId",
          "label",
          "quantity",
          "snapshot",
          "total"
        ]
      },
      "CreateQuickEntryDto": {
        "type": "object",
        "properties": {
          "kcal": {
            "type": "number",
            "example": 640,
            "minimum": 0,
            "maximum": 20000
          },
          "protein": {
            "type": "number",
            "example": 48,
            "minimum": 0,
            "maximum": 5000
          },
          "carbs": {
            "type": "number",
            "example": 72,
            "minimum": 0,
            "maximum": 5000
          },
          "fat": {
            "type": "number",
            "example": 16,
            "minimum": 0,
            "maximum": 5000
          },
          "date": {
            "type": "string",
            "example": "2026-10-04"
          },
          "time": {
            "type": "string",
            "example": "20:30"
          },
          "label": {
            "type": "string",
            "example": "Restaurant italien",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "kcal",
          "protein",
          "carbs",
          "fat",
          "date",
          "time",
          "label"
        ]
      },
      "RestoreLogEntryDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-10-04"
          },
          "time": {
            "type": "string",
            "example": "12:45"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LogKind"
              }
            ]
          },
          "mealId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "label": {
            "type": "string",
            "example": "Bowl poulet riz",
            "minLength": 1,
            "maxLength": 120
          },
          "quantity": {
            "type": "number",
            "example": 1,
            "minimum": 0.25,
            "maximum": 20
          },
          "snapshot": {
            "$ref": "#/components/schemas/NutrientsDto"
          }
        },
        "required": [
          "date",
          "time",
          "kind",
          "label",
          "quantity",
          "snapshot"
        ]
      },
      "MealMode": {
        "type": "string",
        "enum": [
          "ingredients",
          "manual"
        ]
      },
      "MealTotalsSource": {
        "type": "string",
        "enum": [
          "ingredients",
          "manual",
          "override"
        ],
        "description": "Which totals are in use"
      },
      "MealSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Fajitas poulet"
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MealMode"
              }
            ]
          },
          "isFavorite": {
            "type": "boolean"
          },
          "totals": {
            "description": "One portion",
            "allOf": [
              {
                "$ref": "#/components/schemas/NutrientsDto"
              }
            ]
          },
          "totalsSource": {
            "description": "Which totals are in use",
            "allOf": [
              {
                "$ref": "#/components/schemas/MealTotalsSource"
              }
            ]
          },
          "timesEaten": {
            "type": "number",
            "example": 12,
            "description": "Number of times logged"
          },
          "lastEatenOn": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-03",
            "description": "Last day it was logged"
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "isFavorite",
          "totals",
          "totalsSource",
          "timesEaten",
          "lastEatenOn"
        ]
      },
      "FoodSource": {
        "type": "string",
        "enum": [
          "custom",
          "ciqual",
          "off"
        ]
      },
      "FoodUnitDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "c. à s.",
            "minLength": 1,
            "maxLength": 30
          },
          "grams": {
            "type": "number",
            "example": 10,
            "minimum": 0.1,
            "maximum": 2000
          }
        },
        "required": [
          "label",
          "grams"
        ]
      },
      "FoodDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Riz blanc, cuit, non salé"
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FoodSource"
              }
            ]
          },
          "per100g": {
            "description": "Per 100 g",
            "allOf": [
              {
                "$ref": "#/components/schemas/NutrientsDto"
              }
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FoodUnitDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "brand",
          "source",
          "per100g",
          "units"
        ]
      },
      "MealItemDto": {
