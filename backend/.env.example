# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthmanager?schema=public"
# HTTP port (Railway injects PORT)
PORT=3001
# Allowed CORS origin (the Vite dev server locally)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Access key required in the X-Access-Key header of every API call (except /api/health).
# Long random string; open /?key=<value> once on a device to store it there.
ACCESS_KEY=change-me-to-a-long-random-string
