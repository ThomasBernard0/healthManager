// Prisma schema — one model per domain entity.
// Dev migration: `npm run prisma:migrate -- --name <change>`; applied on deploy by `prisma migrate deploy`.
//
// Nutrients are stored as flat columns: kcal as integers, macros (g) as Decimal to 0.1 g.
// Dates are Europe/Paris local dates (`date`), times are "HH:mm".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MealMode {
  ingredients
  manual
}

enum Feeling {
  easy
  ok
  hard
}

enum LogKind {
  meal
  quick
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
}

enum Muscle {
  chest
  back
  shoulders_front
  shoulders_side
  shoulders_rear
  biceps
  triceps
  forearms
  abs
  quads
  hamstrings
  glutes
  calves
}

/// A musculation exercise (Mes exercices).
model Exercise {
  id               String            @id @default(uuid())
  name             String
  /// Lowercase, accents stripped — for accent/case-insensitive search.
  searchName       String
  equipment        Equipment
  primaryMuscles   Muscle[]
  secondaryMuscles Muscle[]
  archived         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  image            ExerciseImage?
  workoutItems     WorkoutItem[]
  sessionExercises SessionExercise[]

  @@index([searchName])
}

/// Picture of an exercise, apart from Exercise so lists never load the bytes.
model ExerciseImage {
  exerciseId String   @id
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  mime       String
  data       Bytes
  updatedAt  DateTime @updatedAt
}

/// A group of workouts. Exactly one is active: its workouts are the rotation, restarted when it is activated.
model Program {
  id          String    @id @default(uuid())
  name        String
  /// Order in Mes programmes (1..n).
  position    Int
  active      Boolean   @default(false)
  /// Last activation: the rotation only counts sessions finished since.
  activatedAt DateTime  @default(now()) @db.Timestamptz
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]
}

/// A session template ("Push A"). position = order in its program's rotation (1..n, compacted on delete).
model Workout {
  id        String        @id @default(uuid())
  name      String
  programId String
  program   Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     WorkoutItem[]
  sessions  Session[]

  @@index([programId])
}

/// An exercise of a workout, in list order, with its sets and rep range.
model WorkoutItem {
  id            String   @id @default(uuid())
  workoutId     String
  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets          Int      @default(4)
  repMin        Int      @default(8)
  repMax        Int      @default(12)
  position      Int
  /// Superset: shared by exactly two adjacent items of the workout (null: solo).
  supersetGroup String?

  @@unique([workoutId, exerciseId])
  @@index([exerciseId])
}

/// One ingredient. Values are per 100 g.
model Food {
  id         String     @id @default(uuid())
  name       String
  /// Lowercase, accents stripped — for accent/case-insensitive search.
  searchName String
  brand      String?
  barcode    String?    @unique
  kcal       Int
  protein    Decimal    @db.Decimal(7, 1)
  carbs      Decimal    @db.Decimal(7, 1)
  fat        Decimal    @db.Decimal(7, 1)
  /// [{ label, grams }] — e.g. { label: "c. à s.", grams: 10 }
  units      Json?
  updatedAt  DateTime   @updatedAt
  mealItems  MealItem[]

  @@index([searchName])
}

/// A saved meal ("Mes repas"). timesEaten / lastEatenAt are derived from LogEntry.
model Meal {
  id              String     @id @default(uuid())
  name            String
  searchName      String
  mode            MealMode
  /// Manual-mode totals (all four or none).
  manualKcal      Int?
  manualProtein   Decimal?   @db.Decimal(7, 1)
  manualCarbs     Decimal?   @db.Decimal(7, 1)
  manualFat       Decimal?   @db.Decimal(7, 1)
  /// Manual correction of the totals (all four or none).
  overrideKcal    Int?
  overrideProtein Decimal?   @db.Decimal(7, 1)
  overrideCarbs   Decimal?   @db.Decimal(7, 1)
  overrideFat     Decimal?   @db.Decimal(7, 1)
  isFavorite      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           MealItem[]
  logEntries      LogEntry[]
}

model MealItem {
  id        String   @id @default(uuid())
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  grams     Decimal  @db.Decimal(7, 1)
  /// Display only: the unit the quantity was entered with (e.g. 1 × "c. à s.").
  unitLabel String?
  unitCount Decimal? @db.Decimal(5, 2)
  position  Int

  @@index([mealId])
  @@index([foodId])
}

/// What I ate. Nutrients are a per-portion snapshot frozen at log time.
model LogEntry {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  time      String   @db.VarChar(5)
  kind      LogKind
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  label     String
  quantity  Decimal  @db.Decimal(5, 2)
  kcal      Int
  protein   Decimal  @db.Decimal(7, 1)
  carbs     Decimal  @db.Decimal(7, 1)
  fat       Decimal  @db.Decimal(7, 1)
  createdAt DateTime @default(now())

  @@index([date])
  @@index([mealId])
}

/// Daily goal, versioned by day: applies from validFrom until the next version.
model Goal {
  id        String   @id @default(uuid())
  validFrom DateTime @unique @db.Date
  dailyKcal Int
  protein   Decimal  @db.Decimal(6, 1)
  carbs     Decimal  @db.Decimal(6, 1)
  fat       Decimal  @db.Decimal(6, 1)
  createdAt DateTime @default(now())
}

/// One performed workout. At most one has finishedAt = null: the session in progress.
model Session {
  id          String            @id @default(uuid())
  workoutId   String?
  workout     Workout?          @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  /// Snapshot, so the history survives deleting the workout.
  workoutName String
  startedAt   DateTime          @default(now()) @db.Timestamptz
  finishedAt  DateTime?         @db.Timestamptz
  exercises   SessionExercise[]

  @@index([finishedAt])
}

/// An exercise of a session. Exercises with no done set are dropped when the session is finished.
model SessionExercise {
  id            String       @id @default(uuid())
  sessionId     String
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  /// Order in the workout (list order); the real order is firstSetAt.
  position      Int
  /// Snapshot of the workout item, so editing the template doesn't rewrite history.
  repMin        Int
  repMax        Int
  /// Time of the first validated set (the real order of the exercises).
  firstSetAt    DateTime?    @db.Timestamptz
  /// Frozen with the first validated set (progression step).
  preFatigue    Decimal?     @db.Decimal(4, 1)
  feeling       Feeling?
  /// Terminé tapped (with at least one set done).
  completed     Boolean      @default(false)
  /// Snapshot of the workout item's group (null: solo, or its partner was skipped).
  supersetGroup String?
  sets          SessionSet[]

  @@unique([sessionId, exerciseId])
  @@index([exerciseId])
}

/// A set: its target (none the first time) and what was done (kg in 0.5 steps, reps).
model SessionSet {
  id                String          @id @default(uuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  index             Int
  targetWeight      Decimal?        @db.Decimal(6, 1)
  targetReps        Int?
  weight            Decimal?        @db.Decimal(6, 1)
  reps              Int?
  done              Boolean         @default(false)
  doneAt            DateTime?       @db.Timestamptz

  @@unique([sessionExerciseId, index])
}
